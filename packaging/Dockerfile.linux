# x86-64 Debian 12 / glibc 2.36, pinned to the official Python image manifest.
FROM python:3.12-slim-bookworm@sha256:0f086103b026048cc50cb5da25ec435c023c5241a83fc44daea593377abc61c4
RUN apt-get update \
    && apt-get install --no-install-recommends -y binutils libtk8.6 xvfb xauth xfonts-base \
    && install -d -m 1777 /tmp/.X11-unix \
    && rm -rf /var/lib/apt/lists/*
ENV GURPS_BUILD_VENV=/tmp/gurps-build-venv XDG_CACHE_HOME=/tmp/gurps-cache
WORKDIR /project
